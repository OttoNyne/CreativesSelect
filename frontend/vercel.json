{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://first-server-2y0v.onrender.com/api/:path*"
    },
    {
      "source": "/p/:username",
      "destination": "https://first-server-2y0v.onrender.com/api/preview/profile/:username"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://first-server-2y0v.onrender.com/api/preview/sitemap.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    }
  ],
  "installCommand": "npm ci",
  "git": {
    "deploymentEnabled": false
  }
}
