{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://first-server-2y0v.onrender.com/api/:path*"
    },
    {
      "source": "/p/:username",
      "destination": "https://first-server-2y0v.onrender.com/api/preview/profile/:username"
    },
    {
      "source": "/embed/piece/:id",
      "destination": "https://first-server-2y0v.onrender.com/api/embed/piece/:id"
    },
    {
      "source": "/embed/profile/:username",
      "destination": "https://first-server-2y0v.onrender.com/api/embed/profile/:username"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://first-server-2y0v.onrender.com/api/preview/sitemap.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/((?!api/|embed/|p/|sitemap\\.xml).*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=()" }
      ]
    }
  ],
  "installCommand": "npm ci",
  "git": {
    "deploymentEnabled": false
  }
}
